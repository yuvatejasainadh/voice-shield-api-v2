APP_NAME=Voice Shield API V2
APP_VERSION=2.0.0
# AWS RDS PostgreSQL connection string (expected format for production)
DATABASE_URL=postgresql+psycopg://<APP_USER>:<PASSWORD>@voiceshield-prod-db.chcku4ke2u3b.ap-south-2.rds.amazonaws.com:5432/voiceshield
MAX_UPLOAD_SIZE_MB=25
STORAGE_PATH=./storage
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RISK_GENUINE_MAX=29
RISK_SUSPICIOUS_MAX=69
MAX_AUDIO_DURATION_SECONDS=600

# Aurigin Real-Time Voice Clone Detection (Primary in-call provider)
# SERVER-SIDE KEY ONLY — never expose to Android or the client
AURIGIN_API_KEY=
AURIGIN_API_BASE_URL=https://api.aurigin.ai
AURIGIN_TIMEOUT_SECONDS=30
AURIGIN_ENABLED=true
AURIGIN_PROVIDER_VERSION=v1

# Reality Defender RealAPI (Standalone audio file deepfake detector)
REALITY_DEFENDER_API_KEY=
REALITY_DEFENDER_API_BASE_URL=https://api.prd.realitydefender.xyz
REALITY_DEFENDER_TIMEOUT_SECONDS=120
