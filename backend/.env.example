# ==============================================================================
# VoiceShield API V2 — Environment Configuration
# ==============================================================================

# Environment mode: 'production', 'development', or 'test'
# Note: 'production' strictly requires an explicit PostgreSQL DATABASE_URL.
ENVIRONMENT=production

APP_NAME=VoiceShield API V2
APP_VERSION=2.0.0
API_VERSION=v2
API_PREFIX=/api/v2

# ==============================================================================
# Database Configuration (PostgreSQL Required for Production)
# ==============================================================================
# Production format (AWS RDS PostgreSQL with psycopg 3 driver):
# DATABASE_URL=postgresql+psycopg://<APP_USER>:<PASSWORD>@<HOST>:5432/<DATABASE>
DATABASE_URL=postgresql+psycopg://dbuser:your_secure_password@voiceshield-prod-db.chcku4ke2u3b.ap-south-2.rds.amazonaws.com:5432/voiceshield

# For local development with PostgreSQL (preferred):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voiceshield_dev

# For local development with isolated SQLite:
# DATABASE_URL=sqlite:///./voice_clone_detection.db

# ==============================================================================
# Storage & Application Limits
# ==============================================================================
MAX_UPLOAD_SIZE_MB=25
STORAGE_PATH=./storage
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==============================================================================
# Detection Risk Thresholds
# ==============================================================================
RISK_GENUINE_MAX=29
RISK_SUSPICIOUS_MAX=69
MAX_AUDIO_DURATION_SECONDS=600

# ==============================================================================
# Aurigin Real-Time Voice Clone Detection (Primary In-Call Provider)
# SERVER-SIDE KEY ONLY — Never expose to client applications
# ==============================================================================
AURIGIN_API_KEY=your_aurigin_api_key_here
AURIGIN_API_BASE_URL=https://api.aurigin.ai
AURIGIN_TIMEOUT_SECONDS=30
AURIGIN_ENABLED=true
AURIGIN_PROVIDER_VERSION=v1

# ==============================================================================
# Reality Defender RealAPI (Standalone Audio File Deepfake Detector)
# ==============================================================================
REALITY_DEFENDER_API_KEY=your_reality_defender_api_key_here
REALITY_DEFENDER_API_BASE_URL=https://api.prd.realitydefender.xyz
REALITY_DEFENDER_TIMEOUT_SECONDS=120
